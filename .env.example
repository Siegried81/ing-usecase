# Copy to .env and fill in your own keys. Never commit .env - check
# .gitignore has ".env" 

# --- LLM (Groq primary, up to 3 keys for free-tier rate-limit rotation) ---
# Only GROQ_API_KEY is required for collection/llm_extractor.py to work;
# _2/_3 are optional extras tried in order if one gets rate-limited.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Leave unset to use the default (openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# --- LLM hosted fallbacks (tried in this order if every Groq key fails) ---
# sieg 15/09: FIXED - these three defaults were guessed, not verified. Now
# match Sieg's actual working portfolio_forecasting .env.example.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-4b:free
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=gpt-oss-120b

# --- LLM fallback, local-dev only (tried if Groq and every hosted fallback fail) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- LLM: the PINNED model for this project (steph 15/09, Decision 6) ---
# One model labels every bank, so a difference between banks is a difference
# between banks and not between two LLMs (NFR-02). The providers above stay as
# fallbacks for an outage; whichever one answers is recorded per row in the
# dataset's extraction_model column, and schema.validate() warns if a dataset
# ends up mixing models.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
