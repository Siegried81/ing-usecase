# Copy to .env and fill in your own keys. Never commit .env - check
# .gitignore has ".env" 

# --- LLM: the PINNED model for this project (steph 15/09, Decision 6) ---
# One model labels every bank, so a difference between banks is a difference
# between banks and not between two LLMs (NFR-02). The providers above stay as
# fallbacks for an outage; whichever one answers is recorded per row in the
# dataset's extraction_model column, and schema.validate() warns if a dataset
# ends up mixing models.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- LLM (Groq, up to 3 keys for free-tier rate-limit rotation) ---
# Only GROQ_API_KEY is required for collection/llm_extractor.py to work;
# _2/_3 are optional extras tried in order if one gets rate-limited.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Leave unset to use the default (openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# --- LLM hosted fallbacks (tried in this order if every Groq key fails) ---
# sieg 15/09: FIXED - these three defaults were guessed, not verified. Now
# match Sieg's actual working portfolio_forecasting .env.example.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-4b:free
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=gpt-oss-120b

# --- LLM fallback, local-dev only (tried if Groq and every hosted fallback fail) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Bank reputation, optional (sieg 19/09) ---
# comparator/reputation.py: recent news headlines per bank, classified into
# themes (innovation, crisis, results, ...) - NOT sentiment, see the module
# docstring. Leave blank to skip entirely; the Reputation tab shows an honest
# "not configured" state instead of guessing. Get a free-tier key at
# https://newsapi.org - never commit the real value, this file is tracked.
NEWSAPI_KEY=

# --- Market context, optional, low priority for this project (sieg 19/09) ---
# comparator/market_context.py: daily stock closes for the handful of banks in
# scope that are actually publicly listed (most are not - see the module
# docstring and docs/decisions.md, 19/09). Not wired into report.json/the web
# UI on purpose; this is a thin, standalone lookup, not a pipeline step.
# Free-tier key at https://finnhub.io.
FINNHUB_API_KEY=

# --- Academic search, optional (sieg 19/09, wired into a Research page 20/09) ---
# comparator/research.py: comparator.research.search_papers(), used from
# streamlit_app.py's Research page for ad-hoc use while writing the business
# narrative - an on-demand search box, not a per-bank metric (none is defined
# for this feature). Semantic Scholar's public API works keyless at low
# volume; a key only raises the rate limit.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
